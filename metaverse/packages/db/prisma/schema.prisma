

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @unique @default(cuid())
  username        String         @unique
  password        String
  avatarId        String?
  wokaAppearance  Json?
  role            Role
  lastSpaceId     String?
  lastX           Int?
  lastY           Int?
  spaces          Space[]
  avatar          Avatar?        @relation(fields: [avatarId], references: [id])
  studySessions   StudySession[]
}

model Space {
  id        String  @id @unique @default(cuid())
  name      String
  width     Int
  height    Int
  thumbnail String?
  mapImage  String?
  code      String  @unique
  official  Boolean @default(false)
  creatorId String
  creator     User    @relation(fields: [creatorId], references: [id])
  elements  spaceElements[]
}

model StudySession {
  id              String    @id @unique @default(cuid())
  userId          String
  spaceId         String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId, endedAt])
}

model spaceElements {
  id        String @id @unique @default(cuid())
  elementId String
  spaceId   String
  x         Int
  y         Int
  space     Space  @relation(fields: [spaceId], references: [id])
  element   Element @relation(fields: [elementId], references: [id])
}

model Element {
  id              String @id @unique @default(cuid())
  width           Int
  height          Int
  static          Boolean
  imageUrl        String
  spaces          spaceElements[]
  mapElements     MapElements[]
}

model Map {
  id     String  @id @unique @default(cuid())
  width  Int
  height Int
  name   String
  thumbnail String
  mapImage  String?
  mapElements MapElements[]
}

model MapElements {
  id        String  @id @unique @default(cuid())
  mapId     String
  elementId String
  x         Int?
  y         Int?
  map       Map     @relation(fields: [mapId], references: [id])
  element   Element @relation(fields: [elementId], references: [id])
}

model Avatar {
  id       String  @id @unique @default(cuid())
  imageUrl String?
  name     String?
  users    User[]
}

enum Role {
  Admin
  User
  Teacher
}
